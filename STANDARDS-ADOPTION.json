      "command": null,
      "enforcement": "manual-review"
    },
    {
      "requirement": "C-31 no secrets",
      "command": null,
      "enforcement": "manual-review"
    },
    {
      "requirement": "C-22, C-23 tests",
      "command": null,
      "enforcement": "manual-review"
    },
    {
